# Optional. With neither key set, the app runs the deterministic coach (the default demo).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model overrides. Defaults: claude-haiku-4-5 and gpt-4.1-mini.
ANTHROPIC_MODEL=
OPENAI_MODEL=

# "anthropic" or "openai" when both keys are set. Default: anthropic.
LLM_PROVIDER=

# Model-backed requests per UTC day, all visitors combined.
DAILY_LLM_LIMIT=200
# Model-backed requests per IP per hour.
LLM_PER_IP_PER_HOUR=10
# All /api/coach requests per IP per minute.
RATE_LIMIT_PER_MIN=20
# Set to 1 behind a proxy that sets X-Forwarded-For (Render does).
TRUST_PROXY=0

PORT=3000
