{
  "name": "second-draft",
  "version": "0.1.0",
  "description": "A tool-using writing coach agent. Deterministic detectors measure the draft; the model (optional) prioritizes and coaches. Every piece of feedback points at a sentence that really exists.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Austin French <austindanielfrench@gmail.com> (https://austn.net)",
  "repository": {
    "type": "git",
    "url": "https://github.com/frogr/second-draft"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs",
    "start": "node dist/server/index.js",
    "dev": "node scripts/build-web.mjs && tsx watch src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx evals/run.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
